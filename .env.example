# SehatSaathi Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively

# ================================
# BACKEND ENVIRONMENT VARIABLES
# ================================
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sehatsaathi
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# Optional: Set to true if you want to use MongoDB Memory Server when local MongoDB is not running
USE_IN_MEMORY_DB=true

# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================
VITE_API_URL=http://localhost:5000/api
